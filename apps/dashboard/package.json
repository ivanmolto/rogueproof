{
  "name": "@rogueproof/dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "RogueProof dashboard: Attack Arena, Defense Control, Trust Report. Never calls Otari; proxies to the orchestrator.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter \"@rogueproof/orchestrator...\" build && next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@rogueproof/orchestrator": "workspace:*",
    "@rogueproof/shared": "workspace:*",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-check": "4.10.2",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5"
  }
}
