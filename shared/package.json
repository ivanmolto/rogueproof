{
  "name": "@rogueproof/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared JSON Schemas (Timeline, run.json, trust-report.json) and the TypeScript types generated from them.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./timeline.schema.json": "./timeline.schema.json",
    "./run.schema.json": "./run.schema.json",
    "./trust-report.schema.json": "./trust-report.schema.json"
  },
  "scripts": {
    "gen:schemas": "node scripts/gen-schemas.mjs",
    "gen:schemas:check": "node scripts/gen-schemas.mjs --check",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "json-schema-to-typescript": "16.0.0"
  }
}
