{
  "name": "rogueproof",
  "version": "0.0.0",
  "private": true,
  "description": "RogueProof \u2014 the proving ground for autonomous AI. Built on Otari by Mozilla.ai.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:otari": "RUN_OTARI=1 vitest run -t \"\\[otari\\]\"",
    "test:sandbox": "RUN_SANDBOX=1 vitest run -t \"\\[sandbox\\]\"",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "gen:schemas": "pnpm --filter @rogueproof/shared gen:schemas",
    "gen:schemas:check": "pnpm --filter @rogueproof/shared gen:schemas:check",
    "smoke": "pnpm -r build && node packages/orchestrator/dist/smoke.js",
    "telemetry": "pnpm -r build && node packages/orchestrator/dist/telemetry.js",
    "honeypot": "pnpm --filter @rogueproof/scenario-honeypot build && node scenarios/honeypot/dist/main.js",
    "collector": "pnpm --filter @rogueproof/scenario-collector build && node scenarios/collector/dist/main.js",
    "registry": "pnpm --filter @rogueproof/scenario-registry build && node scenarios/registry/dist/main.js",
    "tunnel": "pnpm --filter \"@rogueproof/orchestrator...\" build && node packages/orchestrator/dist/tunnel.js",
    "policy:check": "pnpm --filter \"@rogueproof/orchestrator...\" build && node packages/orchestrator/dist/policyCheck.js",
    "sandbox:check": "pnpm --filter \"@rogueproof/orchestrator...\" build && node packages/orchestrator/dist/sandboxCheck.js",
    "run:safe": "pnpm --filter \"@rogueproof/orchestrator...\" build && node packages/orchestrator/dist/runSafe.js",
    "run:permissive": "pnpm --filter \"@rogueproof/orchestrator...\" build && node packages/orchestrator/dist/runPermissive.js",
    "run:control": "pnpm --filter \"@rogueproof/orchestrator...\" build && node packages/orchestrator/dist/runControl.js",
    "run:budget": "pnpm --filter \"@rogueproof/orchestrator...\" build && node packages/orchestrator/dist/runBudget.js",
    "budget:reset": "pnpm --filter \"@rogueproof/orchestrator...\" build && node packages/orchestrator/dist/budgetReset.js",
    "replay": "pnpm --filter \"@rogueproof/orchestrator...\" build && node packages/orchestrator/dist/replay.js",
    "report": "pnpm --filter \"@rogueproof/orchestrator...\" build && node packages/orchestrator/dist/report.js",
    "sandbox:shell": "pnpm --filter \"@rogueproof/orchestrator...\" build && node packages/orchestrator/dist/sandboxShell.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
