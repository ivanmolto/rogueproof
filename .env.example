# Copy to .env (gitignored) and fill in. Keys are server-side only; never NEXT_PUBLIC_.
# Region-specific host as shown by the dashboard onboarding (EU workspace).
OTARI_BASE_URL=https://eu.api.otari.ai/api/v1
# Workspace keys look like otk_v1_eu_... ; created under rogueproof > API keys, shown once.
OTARI_API_KEY_AGENT=
OTARI_API_KEY_JUDGE=
OTARI_API_KEY_REPORT=
OTARI_API_KEY_CAPPED=
OTARI_API_KEY_SERVICE=
# Key in workspace rogueproof-fallback-test, used only by run:safe --fallback-demo (task 4.5)
OTARI_API_KEY_FALLBACK_TEST=
# dev = model D (Claude via own Anthropic provider key) for build-time iteration
# rubric = open-weight models A/B/C only; required for --golden
MODEL_PROFILE=dev
TUNNEL_TOKEN=
HONEYPOT_PUBLIC_URL=
COLLECTOR_PUBLIC_URL=
# openssl rand -hex 32; required by pnpm collector, typed into the dashboard as the MCP server's authorization token
COLLECTOR_BEARER=
# UUID shown by the dashboard after registering the collector (otari-config/apply.md step 7); not a secret
COLLECTOR_MCP_SERVER_ID=
# The benign report registry (decision 003): its own hostname, its own bearer (openssl rand -hex 32), its own server id
REGISTRY_PUBLIC_URL=
REGISTRY_BEARER=
# UUID shown by the dashboard after registering the registry (otari-config/apply.md step 8); not a secret
REGISTRY_MCP_SERVER_ID=
# run:safe --fallback-demo only (task 4.5): the same two servers as registered in the
# rogueproof-fallback-test workspace (otari-config/apply.md step 10). Identifiers, not secrets.
FALLBACK_TEST_COLLECTOR_MCP_SERVER_ID=
FALLBACK_TEST_REGISTRY_MCP_SERVER_ID=
HONEYPOT_PREFIX=/lumen-notes
