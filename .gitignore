# node / build output
node_modules/
dist/
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts
.turbo/
.DS_Store
npm-debug.log*
pnpm-debug.log*

# secrets: every .env file except the example and the mission's FAKE fixture (task 3.3)
.env*
!.env.example
!scenarios/mission/.env

# runs: everything except the redacted golden runs and the Trust Report computed from them
# (task 5.3: the dashboard's /trust-report reads it; it holds counts, costs, model names,
# request ids and the judge's explanations, no key and no payload)
runs/*
!runs/golden/
!runs/trust-report.json

# third-party repos (read-only, never committed)
vendor/

# docs/ stays ignored until the submission review decides what to publish
# (the five private notes VERSIONS/DEVIATIONS/FAILURES/IDEAS/LOG never are).
docs/

# Playwright output (apps/dashboard e2e)
test-results/
playwright-report/
